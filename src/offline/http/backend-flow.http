# offline 환경 선택 후 session-offline.http에서 회원 세션을 준비합니다.
# B/E가 실행되어 있어야 합니다. 새 대화는 FE가 threadId를 생성합니다.

### 1. 대화 진행 (ag-ui 원문 중계)
# @no-cookie-jar
POST {{baseUrl}}/api/chat?channelId={{channelId}}
Origin: {{baseUrl}}
Cookie: {{sessionCookie}}={{shSession}}
Content-Type: application/json
Accept: text/event-stream

{"threadId":"{{threadId}}","runId":"1","messages":[{"id":"user-1","role":"user","content":"카드 분실신고 해줘"}],"tools":[],"context":[],"forwardedProps":null}

### 2. 대화 목록 (회원 기능, 세션 연장 없음)
# @no-cookie-jar
GET {{baseUrl}}/api/chat/threads?channelId={{channelId}}
Cookie: {{sessionCookie}}={{shSession}}

### 3. 메시지 이력 (세션 연장 없음)
# @no-cookie-jar
GET {{baseUrl}}/api/chat/threads/{{threadId}}/messages?channelId={{channelId}}
Cookie: {{sessionCookie}}={{shSession}}

### 4. 위자드 데이터 조회 (실제 B/E가 등록한 도구/라우트 사용)
# @no-cookie-jar
POST {{baseUrl}}/api/chat/threads/{{threadId}}/tools/process_lost_card_report/cards?channelId={{channelId}}
Origin: {{baseUrl}}
Cookie: {{sessionCookie}}={{shSession}}
Content-Type: application/json

{}

### 5. 클릭 활동 (B/E 호출 없음)
# @no-cookie-jar
POST {{baseUrl}}/api/click?channelId={{channelId}}
Origin: {{baseUrl}}
Cookie: {{sessionCookie}}={{shSession}}
Content-Type: application/json

{"threadId":"{{threadId}}","scenarioId":"lost-card","state":"selected","component":"next-button"}

### 6. 티켓 통합인증 후 interrupt 재개
# python3 src/offline/http/encode-offline-mfa.py 출력값을 mfaResult에 입력합니다.
# interruptId는 실제 B/E가 반환한 값으로 바꿉니다. 모든 인증 입력은 offline 합성값입니다.
# @no-cookie-jar
POST {{baseUrl}}/api/chat?channelId={{channelId}}
Origin: {{baseUrl}}
Cookie: {{sessionCookie}}={{shSession}}; __state_as_id=demo-state
Content-Type: application/json
X-Mfa-Result: {{mfaResult}}
Accept: text/event-stream

{"threadId":"{{threadId}}","runId":"1","messages":[{"id":"user-1","role":"user","content":"카드 분실신고 해줘"}],"tools":[],"context":[],"forwardedProps":null,"resume":[{"interruptId":"{{interruptId}}","status":"resolved","payload":{}}]}
