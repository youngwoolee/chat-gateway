# IntelliJ IDEA HTTP Client용. 1 → 2 → 3 순서로 개별 실행합니다.
# baseUrl은 경로·끝 슬래시 없는 scheme://host:port이며 Origin과 일치해야 합니다.
# channelId는 서버 chat.channels.allowed에 등록된 실제 값으로 바꾸세요.
# 내부망 기본 프로필은 세션 서비스 연결·자격증명이 필요합니다.
# 게스트를 차단하는 staging 채널에서는 1번이 403입니다. 회원 세션은 아래 선택 요청으로 생성하세요.
# HTTP에서도 테스트하도록 Secure 쿠키를 Cookie 헤더에 명시합니다.
# 브라우저의 Secure 쿠키 정책을 변경하는 설정이 아닙니다.
# 응답·HTTP Client 전역 변수에는 세션/인증값이 남을 수 있으므로 외부에 공유하지 마세요.
# 5분 동안 활동이 없으면 1번 또는 회원 세션 요청부터 다시 실행하세요.

@baseUrl = http://localhost:8080
@channelId = 00000000-0000-0000-0000-000000000001
@serviceNm = main
@threadId = entry-test-thread-001

### 1. 게스트 세션 생성 — 기존 쿠키 없이 요청 (200 / GUEST)
# @no-cookie-jar
POST {{baseUrl}}/api/auth/session?channelId={{channelId}}
Origin: {{baseUrl}}

> {%
    client.assert(response.status === 200, "세션 생성 실패: " + response.status);
    const name = "__Host-sh-session_" + request.variables.get("channelId").split("-")[0];
    const cookie = response.headers.valuesOf("Set-Cookie").find(v => v.startsWith(name + "="));
    client.assert(cookie, "세션 Set-Cookie 없음");
    client.global.set("entrySessionCookie", cookie.split(";")[0]);
    client.assert(response.body.userType === "GUEST", "GUEST 응답 확인");
%}

### 2. 진입 파라미터를 포함한 채팅 (SSE / JSON)
# 현재 GW: channelId는 인증 헤더로, serviceNm은 query로 전달됩니다.
# 문서 요구사항인 serviceNm 헤더 변환 / agent_channel_code YAML 매핑은 아직 미구현입니다.
# 아래 응답만으로 GW → B/E 헤더는 확인할 수 없습니다. B/E 수신 로그/디버거에서 확인하세요.
# 기대: X-Authenticated-User-Id=회원 또는 게스트 ID, X-Authenticated-Channel-Id=전체 channelId
# 추가 구현 후 확인: serviceNm=진입값, agent_channel_code=서버 YAML 매핑값 (헤더 이름 협의 필요)
# @no-cookie-jar
POST {{baseUrl}}/api/chat?channelId={{channelId}}&serviceNm={{serviceNm}}
Origin: {{baseUrl}}
Cookie: {{entrySessionCookie}}
Content-Type: application/json
Accept: text/event-stream

{
  "threadId": "{{threadId}}",
  "runId": "{{$uuid}}",
  "messages": [
    {"id": "{{$uuid}}", "role": "user", "content": "안녕하세요"}
  ],
  "tools": [],
  "context": [],
  "forwardedProps": null
}

### 3. 세션 재사용 (200, 세션 부재·만료 시 새 게스트 세션 생성)
# @no-cookie-jar
POST {{baseUrl}}/api/auth/session?channelId={{channelId}}
Origin: {{baseUrl}}
Cookie: {{entrySessionCookie}}

> {%
    client.assert(response.status === 200, "세션 재사용 실패: " + response.status);
    const name = "__Host-sh-session_" + request.variables.get("channelId").split("-")[0];
    const cookie = response.headers.valuesOf("Set-Cookie").find(v => v.startsWith(name + "="));
    if (cookie) client.global.set("entrySessionCookie", cookie.split(";")[0]);
    ["X-Chat-User-Type", "X-Chat-Auth-Expires-At", "X-Server-Time"].forEach(name => {
        client.assert(response.headers.valueOf(name) !== null, name + " 응답 헤더 없음");
    });
%}

### 4. 대화 목록 조회 — 회원 여부 등 B/E 정책에 따라 응답이 달라질 수 있습니다.
# @no-cookie-jar
GET {{baseUrl}}/api/chat/threads?channelId={{channelId}}
Cookie: {{entrySessionCookie}}
Accept: application/json

### 5. 메시지 이력 조회 — 2번에서 생성한 threadId
# @no-cookie-jar
GET {{baseUrl}}/api/chat/threads/{{threadId}}/messages?channelId={{channelId}}
Cookie: {{entrySessionCookie}}
Accept: application/json

### 선택. 내부망 PFC 회원 세션 생성 → 성공 후 2번부터 실행
# 실제 인증값은 파일에 저장하지 말고 HTTP Client private 환경 변수로 설정하세요.
# pfcSystemCode / pfcAuthentication / pfcVerify 값은 기존 플랫폼에서 발급받습니다.
# Gateway의 PfcAuthService·CookieService에 내부망 구현을 연결한 후 사용합니다.
# 현재 로컬 placeholder 구현으로는 회원 로그인이 되지 않습니다.
# @no-cookie-jar
POST {{baseUrl}}/api/auth/session?channelId={{channelId}}
Origin: {{baseUrl}}
Cookie: PlatformSystemCode_O={{pfcSystemCode}}; PlatformAuthentication_O={{pfcAuthentication}}; PlatformVerify_O={{pfcVerify}}

> {%
    client.assert(response.status === 200, "회원 세션 생성 실패: " + response.status);
    client.assert(response.body.userType === "MEMBER", "PFC 실패 시 GUEST일 수 있으므로 유형 확인 필요");
    const name = "__Host-sh-session_" + request.variables.get("channelId").split("-")[0];
    const cookie = response.headers.valuesOf("Set-Cookie").find(v => v.startsWith(name + "="));
    client.assert(cookie, "세션 Set-Cookie 없음");
    client.global.set("entrySessionCookie", cookie.split(";")[0]);
%}
